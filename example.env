# ── Supabase Configuration ─────────────────────────────────────────────
# Client-side (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-side (Private / SSR)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── AI Providers (Choose 'gemini', 'openrouter', 'deepseek', or 'ollama') ─
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Ollama Local AI (If using AI_PROVIDER=ollama) ────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3
OLLAMA_REASONING_MODEL=deepseek-r1
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# ── Email Service (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key

# ── Google OAuth & Calendar Integration ────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/google-calendar/callback
APP_USER_CONNECTION_KEY_SECRET=a-random-32-byte-hex-secret-for-key-encryption

# ── eSewa Payment Integration (Nepal) ──────────────────────────────────
# Test credentials:
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/status/v2
