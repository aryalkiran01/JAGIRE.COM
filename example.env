# ── Application Environment ──────────────────────────────────
NODE_ENV=production

# ── Supabase Backend & Database ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Production AI Engine (Google Gemini) ─────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Transactional Email (Resend) ─────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM="Jagire <notifications@jagire.aryalkiran21.com.np>"

# ── Google Calendar & OAuth ───────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/google-calendar/callback
APP_USER_CONNECTION_KEY_SECRET=your_32_character_encryption_secret

# ── eSewa Payment Gateway (Sandbox on Production Supported) ───
# Set ESEWA_ENVIRONMENT to "sandbox" for testing on production Jagire, or "production" for live payments.
ESEWA_ENVIRONMENT=sandbox
ESEWA_MERCHANT_CODE=your_sandbox_merchant_code
ESEWA_SECRET_KEY=your_sandbox_secret
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/status/v2

# ── Optional Local Development Only (Ollama Fallback) ─────────
# Gemini is primary. Ollama acts as local development fallback if Gemini fails/times out.
# Set AI_PROVIDER=gemini-only if you want to disable local Ollama fallback.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3
# OLLAMA_REASONING_MODEL=deepseek-r1
# OLLAMA_FAST_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large